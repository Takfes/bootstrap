{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "preferences": {
    "tmuxSplitPanes": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=/tmp/.claude-tink; now=$(date +%s); [ -f \"$f\" ] && [ $((now - $(cat \"$f\"))) -lt 2 ] && exit 0; echo \"$now\" > \"$f\"; afplay /System/Library/Sounds/Tink.aiff",
            "async": true
          }
        ]
      }
    ]
  }
}

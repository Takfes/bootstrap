# {{project_name}} — development commands
#
# BOOTSTRAP TEMPLATE NOTE:
#   {{project_name}} and {{package_name}} are placeholders substituted by the bootstrap CLI.
#   Do not run `just` commands in a freshly cloned template repo before substitution.
#   The {{args}} in the `run` recipe IS valid just syntax (variadic argument).

# List available commands (default)
default:
	@just --list

# ── Setup & Environment ──────────────────────────────────────────────────────────────

# Install all dependencies and pre-commit hooks
install:
	uv sync --all-extras --dev
	uv run pre-commit install --hook-type pre-commit --hook-type pre-push --hook-type commit-msg

# Upgrade all dependencies to their latest allowed versions
update:
	uv sync --upgrade --all-extras --dev

# Update the lockfile without syncing the environment
lock:
	uv lock

# Show Python version, venv path, and installed packages
venv:
	@uv run python --version
	@uv run python -c "import sys; print('Virtual env path:', sys.prefix)"
	@echo "Installed packages:"
	@uv run pip list

# Reset the virtual environment — delete .venv and reinstall everything
reset-venv:
	#!/usr/bin/env sh
	printf "This will delete .venv and reinstall. Are you sure? [y/N] "
	read ans
	case "$ans" in
	    [yY]*) rm -rf .venv && uv sync --all-extras --dev && uv run pre-commit install --hook-type pre-commit --hook-type pre-push --hook-type commit-msg ;;
	    *) echo "Aborted." ;;
	esac

# Remove cache and temporary files (requires clean-cache-files hook in .pre-commit-config.yaml)
clean-cache:
	uv run pre-commit run clean-cache-files

# Remove all generated artefacts (.venv, dist, caches, coverage)
clean: clean-build
	rm -rf .venv htmlcov/ .coverage coverage.xml .mypy_cache .pytest_cache .ruff_cache __pycache__

# ── Code Quality ───────────────────────────────────────────────────────────────

# Lint (check only, no fixes)
ruff-check:
	uv run ruff check src/ tests/

# Format check (no fixes)
ruff-format:
	uv run ruff format --check src/ tests/

# Fix lint issues (auto-fix)
fix:
	uv run ruff check --fix src/ tests/
	uv run ruff format src/ tests/

# Alias: format code (same as fix)
format: fix

# Check docstring coverage
interrogate:
	uv run interrogate src/

# Check for unused/missing dependencies
deptry:
	uv run deptry .

# Type check
typecheck:
	uv run mypy

# Run all Python linting and analysis checks
lint: ruff-check ruff-format interrogate deptry

# ── Security & Validation ────────────────────────────────────────────────────────

# Scan for hardcoded secrets (requires gitleaks hook in .pre-commit-config.yaml)
gitleaks:
	uv run pre-commit run gitleaks

# Run all file validation checks (requires hooks in .pre-commit-config.yaml)
file-checks:
	uv run pre-commit run check-case-conflict
	uv run pre-commit run check-merge-conflict
	uv run pre-commit run end-of-file-fixer
	uv run pre-commit run trailing-whitespace
	uv run pre-commit run check-added-large-files
	uv run pre-commit run mixed-line-ending
	uv run pre-commit run check-json
	uv run pre-commit run pretty-format-json
	uv run pre-commit run check-toml
	uv run pre-commit run check-yaml
	uv run pre-commit run check-xml
	uv run pre-commit run check-executables-have-shebangs
	uv run pre-commit run check-shebang-scripts-are-executable

# Run all validation and security checks
validate: file-checks gitleaks clean-cache

# ── Testing ───────────────────────────────────────────────────────────────────────────

# Run tests
test:
	uv run pytest

# Run tests with coverage report
test-cov:
	uv run pytest --cov --cov-report=term-missing --cov-report=html
	@echo "Coverage report: htmlcov/index.html"

# ── Pre-commit & Hooks ────────────────────────────────────────────────────────────

# Run pre-commit hooks on currently staged files
pre-commit-staged:
	uv run pre-commit run

# Run pre-commit hooks on all files in the repo
pre-commit-all:
	uv run pre-commit run --all-files

# Run all hooks consolidated (lint + validate)
hooks: lint validate

# ── Quality Gates ───────────────────────────────────────────────────────────────────────

# Full quality gate: lock check + pre-commit (all files) + mypy + tests
check: test
	uv lock --locked
	uv run pre-commit run --all-files
	uv run mypy

# Run exactly what CI runs (initially identical to check; diverge as needed)
ci: check

# ── Build ─────────────────────────────────────────────────────────────────────────────

# Remove build artefacts (dist/, build/)
clean-build:
	rm -rf dist/ build/

# Build the package (wheel + sdist)
build: clean-build
	uv build

# ── Run ────────────────────────────────────────────────────────────────────────────

# Run the project (pass extra args after --)
# BOOTSTRAP TEMPLATE: {{package_name}} is replaced by the bootstrap CLI before first use.
run *args:
	uv run python -m {{package_name}} {{args}}

# ── Docs ──────────────────────────────────────────────────────────────────────────────

# Build documentation (requires docs component: uv add --group docs mkdocs-material)
docs-build:
	uv run mkdocs build

# Serve documentation locally with live reload
docs-serve:
	uv run mkdocs serve

# Build docs and fail on any warning (use in CI)
docs-test:
	uv run mkdocs build -s
